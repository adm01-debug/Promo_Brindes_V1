# Configuração de ambiente — exemplo. Copie para .env.local e preencha.
# Segredos verdadeiros ficam somente nas variáveis de ambiente da Vercel/Supabase.

# --- Geral ---

# URL pública do site (https://...). Usada para calcular a origem permitida nas
# requisições de lead e como base de links relativos.
SITE_PUBLIC_ORIGIN=https://www.promobrindes.com.br

# Chave `service_role` do projeto Supabase do site (xlzmclcjdncjfdrjxclt).
# Usada apenas no servidor (API Routes / edge functions), nunca no cliente.
SITE_SUPABASE_SERVICE_JWT=

# URL do projeto Supabase do site (alvo da API Routes).
SITE_SUPABASE_URL=https://xlzmclcjdncjfdrjxclt.supabase.co

# Segredo usado para derivar o hash de idempotência do lead.
SITE_REQUEST_HASH_SALT=

# Segredo do cron (≥32 caracteres). A Vercel injeta em CRON_SECRET quando
# chamadas vêm de crons configurados em vercel.json.
CRON_SECRET=

# Endpoint HTTPS de alertas operacionais (ex.: Teams/Slack). Opcional: sem ele
# o sistema segue operando.
OPERATIONS_ALERT_WEBHOOK_URL=

# SITE_API para funções que autenticam via Site JWT (supabase_auth_admin).
SITE_API_JWT_SECRET=

# --- Alertas comerciais (PF-01) ---

# Alerta comercial de orçamento (PF-01). Endpoint HTTPS controlado pelo time
# comercial (Teams, Slack ou gateway de e-mail); recebe o envelope do lead
# (contato e itens), nunca credenciais. A token é opcional caso o destino não
# a exija. Sem estas variáveis o site segue operando — só o aviso interno
# fica desativado.
COMMERCIAL_TEAM_WEBHOOK_URL=https://cole_o_endpoint_https_de_alertas_comerciais
COMMERCIAL_TEAM_WEBHOOK_TOKEN=cole_somente_na_vercel
