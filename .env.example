# Projeto canônico compartilhado com o Promo Gifts (somente leitura no site público)
VITE_SUPABASE_URL=https://doufsxqlfjyuvxuezpln.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=cole_a_publishable_key_do_projeto_canonico

# View pública mínima. Enquanto a migração ainda não existir, o app recua somente
# em caso de 404 para a view legada, mantendo o preview funcional.
VITE_PRODUCT_CATALOG_RESOURCE=v_site_products_public

# Rotas server-side do próprio site. Ative-as somente depois de configurar as três
# variáveis SITE_* abaixo no ambiente seguro da Vercel. Sem estas VITE_* o site
# mantém o fallback por e-mail e o preview local continua funcional.
VITE_QUOTE_REQUEST_ENDPOINT=
VITE_CONTACT_REQUEST_ENDPOINT=
VITE_PUBLIC_URL=https://promo-brindes-v1.vercel.app
VITE_CONTACT_EMAIL=adm01@promobrindes.com.br

# NOVO Supabase exclusivo do Site Promo Brindes (somente backend; nunca VITE_*).
# SITE_SUPABASE_URL deve apontar para outro project ref, nunca doufsxqlfjyuvxuezpln.
SITE_SUPABASE_URL=https://SEU_NOVO_PROJECT_REF.supabase.co
SITE_SUPABASE_SECRET_KEY=sb_secret_COLE_SOMENTE_NA_VERCEL
SITE_REQUEST_HASH_SALT=gere_um_valor_aleatorio_com_pelo_menos_32_caracteres
SITE_PUBLIC_ORIGIN=https://promo-brindes-v1.vercel.app
