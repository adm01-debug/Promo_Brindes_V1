# Projeto canônico compartilhado com o Promo Gifts (somente leitura no site público)
VITE_SUPABASE_URL=https://doufsxqlfjyuvxuezpln.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=cole_a_publishable_key_do_projeto_canonico

# View pública mínima. Enquanto a migração ainda não existir, o app recua somente
# em caso de 404 para a view legada, mantendo o preview funcional.
VITE_PRODUCT_CATALOG_RESOURCE=v_site_products_public

# Rotas server-side do próprio site. Ative-as somente depois de configurar as três
# variáveis SITE_* abaixo no ambiente seguro da Vercel. Sem estas VITE_* o site
# mantém o fallback por e-mail e o preview local continua funcional.
VITE_QUOTE_REQUEST_ENDPOINT=/api/quote-requests
VITE_CONTACT_REQUEST_ENDPOINT=/api/contact-requests
VITE_PUBLIC_URL=https://promo-brindes-v1.vercel.app
VITE_CONTACT_EMAIL=adm01@promobrindes.com.br

# Autenticação da Área do Cliente no Supabase exclusivo do site. A publishable
# key pode estar no bundle; nunca use a secret key em uma variável VITE_*.
VITE_SITE_SUPABASE_URL=https://xlzmclcjdncjfdrjxclt.supabase.co
VITE_SITE_SUPABASE_PUBLISHABLE_KEY=cole_a_publishable_key_do_supabase_do_site
# Preview exige um projeto/branch Supabase separado, com URL e publishable key
# próprios no escopo Preview da Vercel. Sem ref explícito o login falha fechado.
# VITE_SITE_PREVIEW_PROJECT_REF=ref_de_20_caracteres_somente_no_preview
# Só habilite depois que a migration 20260910130000 estiver aplicada e auditada.
VITE_CUSTOMER_ADJUSTMENTS_ENABLED=false
# Só habilite depois que a migration 20260910140000 estiver aplicada e auditada.
VITE_QUOTE_DECISION_GROUPS_ENABLED=false
# Só habilite depois que a migration 20260911170000 estiver aplicada, testada e auditada.
# Quando ativa, a seleção compartilhada usa token opaco, expira em 30 dias e pode ser revogada pelo criador.
VITE_PERSISTENT_SHARED_SELECTIONS_ENABLED=false

# NOVO Supabase exclusivo do Site Promo Brindes (credenciais administrativas somente backend).
# SITE_SUPABASE_URL deve apontar exclusivamente ao Supabase isolado do site.
SITE_SUPABASE_URL=https://xlzmclcjdncjfdrjxclt.supabase.co
SITE_SUPABASE_SECRET_KEY=sb_secret_COLE_SOMENTE_NA_VERCEL
# Preview: configure SITE_PREVIEW_SUPABASE_PROJECT_REF, SITE_SUPABASE_URL,
# SITE_SUPABASE_SECRET_KEY e SITE_REQUEST_HASH_SALT exclusivos da branch.
# Nunca reutilize a URL/secret de produção nem a do Promo Gifts. Em Preview,
# as notificações externas ficam bloqueadas mesmo com secrets herdados.
# Etapa 25 do plano de correções (docs/RUNBOOK_SITE_API_CUTOVER.md): opcional, tem
# prioridade sobre SITE_SUPABASE_SECRET_KEY quando presente. JWT de privilégio mínimo
# (role site_api) gerado por `npm run db:site:generate-site-api-jwt`. Sem esta variável,
# o backend continua usando SITE_SUPABASE_SECRET_KEY. Mesmo com o JWT ativo,
# a retenção usa a chave secret para excluir propostas na Storage API; não a remova
# até que exista uma credencial de Storage substituta e testada.
SITE_SUPABASE_SERVICE_JWT=
# Segredo aleatório com ao menos 32 caracteres; a Vercel Cron o envia no Authorization.
CRON_SECRET=gere_um_segredo_aleatorio_longo_e_unico
SITE_REQUEST_HASH_SALT=gere_um_valor_aleatorio_com_pelo_menos_32_caracteres
SITE_PUBLIC_ORIGIN=https://promo-brindes-v1.vercel.app

# Comprovantes transacionais. Sem estas variáveis, o orçamento é salvo e a fila
# permanece pendente; nenhuma credencial é exposta ao navegador.
RESEND_API_KEY=re_COLE_SOMENTE_NA_VERCEL
SITE_EMAIL_FROM=Promo Brindes <atendimento@seudominio.com.br>
# WhatsApp é opcional e só é enfileirado após o checkbox específico do cliente.
# O template aprovado deve receber, nesta ordem: nome, protocolo e empresa.
WHATSAPP_ACCESS_TOKEN=cole_somente_na_vercel
WHATSAPP_PHONE_NUMBER_ID=cole_o_id_numerico
WHATSAPP_QUOTE_TEMPLATE=confirmacao_orcamento_promo_brindes
WHATSAPP_GRAPH_API_VERSION=v23.0

# Webhooks de entrega/devolução (Etapa 30). Sem estas variáveis, os endpoints
# api/notification-events-resend e api/notification-events-whatsapp
# respondem 503 e não aplicam nenhum evento — a fila continua operando
# normalmente, só o rastreio de entrega/devolução fica desativado.
# Segredo de assinatura do webhook do Resend (painel > Webhooks), formato whsec_...
RESEND_WEBHOOK_SECRET=whsec_COLE_SOMENTE_NA_VERCEL
# App Secret da Meta (painel do app > Configurações básicas), usado para validar
# o header X-Hub-Signature-256 dos webhooks do WhatsApp Cloud API.
WHATSAPP_APP_SECRET=cole_somente_na_vercel
# Token arbitrário escolhido por nós, usado só no handshake de verificação
# (GET com hub.mode=subscribe) ao cadastrar a URL do webhook no painel da Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=gere_um_token_aleatorio_e_unico

# Alertas operacionais dos dois crons. Endpoint HTTPS controlado pelo time
# (Slack, PagerDuty ou gateway de e-mail); recebe apenas evento e contagens,
# nunca dados do cliente. A token é opcional caso o destino não a exija.
OPERATIONS_ALERT_WEBHOOK_URL=https://cole_o_endpoint_https_de_alertas
OPERATIONS_ALERT_WEBHOOK_TOKEN=cole_somente_na_vercel
